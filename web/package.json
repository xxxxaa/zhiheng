{
  "name": "asset-atlas",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "mobile:sync": "npm run build && cap sync",
    "android:build": "npm run mobile:sync && cd android && ./gradlew assembleDebug",
    "ios:open": "cap open ios",
    "version:android": "node build/set-version.mjs",
    "release:android": "node build/release-android.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "aws4fetch": "^1.0.20",
    "decimal.js": "^10.5.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "fake-indexeddb": "^6.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
